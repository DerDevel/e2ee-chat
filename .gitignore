# Generated protobuf code — committed for the proto package so that builds
# and CI work without protoc installed. Regenerate with `make proto`.
*.pb.go
!proto/*.pb.go

# TLS materials and secrets — never commit these
*.crt
*.key
*.pem
*.p12

# Local configuration
.env
.env.*

# Build artifacts
/bin/
/client/client
/server/server

# Editor / OS
.DS_Store
*.swp

# Local tooling state
.mimosa/
.video_agent/
